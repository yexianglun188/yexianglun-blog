# ============================================================
#  生产环境变量模板
#  用法：cp .env.prod.example .env.prod  然后按需修改
# 注意：本文件会被提交到仓库。真实密钥写在 .env.prod（已被 .gitignore 排除），
#       不要把真实密钥提交到仓库 —— 首次部署脚本会由本模板生成 .env.prod 并填入随机值。
# ============================================================

# -------- 数据库（db 容器初始化时使用）--------
# 这三项只在数据库卷为空的首次启动生效。之后修改必须先清空卷，操作前务必备份。
POSTGRES_DB=kirameku
POSTGRES_USER=postgres
POSTGRES_PASSWORD=CHANGE_ME_STRONG_PASSWORD

# -------- 应用密钥 --------
# JWT 签发密钥，任意修改会导致已登录用户被登出（重新登录即可，不影响数据）
SECRET_KEY=CHANGE_ME_RANDOM_SECRET_KEY

# -------- 跨域白名单 --------
# 浏览器请求都走同源 /api/*（由 Next 服务端转发），正常情况下用不到。
# 若以后用域名独立部署前端，把前端来源加进来，逗号分隔。
CORS_ORIGINS=http://localhost:3000,http://localhost:8000

# -------- GitHub OAuth（不用就留空）--------
GITHUB_CLIENT_ID=
GITHUB_CLIENT_SECRET=

# -------- 阿里云 OSS（留空则图片上传走本地 uploads 目录）--------
OSS_ACCESS_KEY_ID=
OSS_ACCESS_KEY_SECRET=
OSS_BUCKET_NAME=
OSS_ENDPOINT=oss-cn-beijing.aliyuncs.com
OSS_CUSTOM_DOMAIN=
OSS_PREFIX=Boke/

# -------- 对外端口 --------
HTTP_PORT=80
